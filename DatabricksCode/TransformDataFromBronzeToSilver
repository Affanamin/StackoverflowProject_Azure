dfUsersTransformed = dfUsers.withColumn("AboutMe", f.regexp_replace(f.col("AboutMe"), r'<.*?>|\\n', ''))\
                            .withColumn("AboutMe", f.when(f.col("AboutMe") == '', None).otherwise(f.col("AboutMe")))\
                            .filter(f.col("id") > 0) \
                            .drop('Age','EmailHash')

silverContainer = '/mnt/silverlayer/'
directoryName = '/Users'
fullPath_Users = silverContainer + 'dbo' + directoryName

dfUsersTransformed.write.format("delta")\
                        .mode("overwrite")\
                        .option("path",fullPath_Users)\
                        .save()

